---
const siteTitle = "Embellish & Nourish";
const tagline = "Science, Scripture, joy, and stories that help hearts grow.";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteTitle}</title>

    <style>
      :root {
        --jade-bg: #f3fbf8;
        --jade-soft: #dff3ec;
        --jade-main: #6fb7a7;
        --jade-dark: #2f6f64;

        --text: #162422;
        --muted: rgba(22, 36, 34, 0.72);
        --card: #ffffff;
        --border: rgba(47, 111, 100, 0.22);
        --shadow: 0 10px 28px rgba(0, 0, 0, 0.06);
      }

      body {
        margin: 0;
        font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
        background: var(--jade-bg);
        color: var(--text);
      }

      a {
        color: var(--jade-dark);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      .card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 16px;
        transition: transform 160ms ease, box-shadow 160ms ease;
      }

      .card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow);
      }

      .btn {
        display: inline-block;
        padding: 10px 16px;
        border-radius: 14px;
        background: var(--jade-main);
        color: white;
        font-weight: 600;
        border: 1px solid rgba(0, 0, 0, 0.06);
        transition: transform 160ms ease, filter 160ms ease;
        font-size: 14px;
      }

      .btn:hover {
        text-decoration: none;
        transform: translateY(-1px);
        filter: brightness(0.97);
      }

      .cover {
        width: 100%;
        height: 280px;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid rgba(0, 0, 0, 0.06);
        background: var(--jade-soft);
      }

      .section-title {
        font-size: 28px;
        margin: 0 0 14px;
        letter-spacing: -0.2px;
      }

      .muted {
        color: var(--muted);
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
      }
    </style>
  </head>

  <body>
    <main style="max-width: 1020px; margin: 0 auto; padding: 52px 20px;">

      <!-- HERO -->
      <header style="display:flex; justify-content:space-between; align-items:flex-start; gap: 20px; flex-wrap: wrap;">
        <div style="max-width: 70ch;">
          <h1 style="margin:0; font-size: 44px; letter-spacing: -0.6px;">{siteTitle}</h1>
          <p class="muted" style="margin:12px 0 0; font-size: 18px; line-height:1.7;">
            {tagline}
          </p>
        </div>

        <nav style="display:flex; gap: 18px; font-size: 15px; padding-top: 8px;">
          <a href="#author">Author</a>
          <a href="#books">Books</a>
          <a class="btn" href="https://embellishandnourish.substack.com" target="_blank" rel="noopener">Subscribe
</a>

        </nav>
      </header>

      <!-- AUTHOR -->
      <section id="author" style="margin-top: 56px;">
        <h2 class="section-title">About the Author</h2>

        <div class="card" style="display:grid; grid-template-columns: 150px 1fr; gap: 22px; align-items:center;">
          <img
            src="/images/author.jpg"
            alt="Deena Vardhini author photo"
            style="width:150px; height:150px; border-radius:50%; object-fit:cover; border:1px solid var(--border); background:var(--jade-soft);"
          />

          <div>
            <p style="margin:0; font-size:16px; line-height:1.75;">
              <strong>Deena Vardhini, PhD</strong>
            </p>

            <p style="margin:10px 0 0; font-size:16px; line-height:1.75;">
              Hi, I'm Deena. I'm a writer, an educator, and a researcher. I'm all about exploring Joy and Design in Faith, Science, Cooking, Art, and Story, because they all meet in everyday wonder.
            </p>

            <p class="muted" style="margin:12px 0 0; line-height:1.7;">
              Okinawa, Japan • Writing, teaching, and building resources for thoughtful living
            </p>
          </div>
        </div>
      </section>

      <!-- BOOKS -->
      <section id="books" style="margin-top: 60px;">
        <h2 class="section-title">Books</h2>
        <p class="muted" style="margin:0 0 20px; line-height:1.7;">
          Browse current titles and ongoing projects.
        </p>

        <div class="grid">

          <!-- BOOK 1 -->
          <article class="card">
            <img class="cover" src="/images/books/joy-365.jpg" alt="Embellish & Nourish Your Heart with Joy cover" />
            <h3 style="margin:14px 0 6px;">Embellish & Nourish Your Heart with Joy</h3>
            <p class="muted" style="margin:0 0 12px; font-size:14px;">365 days of living in the Word</p>
            <a class="btn" href="https://www.amazon.co.jp/dp/B0FF1MTLGB" target="_blank" rel="noopener">Buy on Amazon</a>
          </article>

          <!-- BOOK 2 -->
          <article class="card">
            <img class="cover" src="/images/books/speak-life.jpg" alt="Speak Life cover" />
            <h3 style="margin:14px 0 6px;">Speak Life</h3>
            <p class="muted" style="margin:0 0 12px; font-size:14px;">The power of words</p>
            <a class="btn" href="https://www.amazon.co.jp/dp/B0G7C7CNKH" target="_blank" rel="noopener">Buy on Amazon</a>
          </article>

          <!-- BOOK 3 -->
          <article class="card">
            <img class="cover" src="/images/books/biology-of-becoming.jpg" alt="Biology of Becoming cover" />
            <h3 style="margin:14px 0 6px;">Biology of Becoming</h3>
            <p class="muted" style="margin:0 0 12px; font-size:14px;">A guide for teens</p>
            <a class="btn" href="https://www.amazon.co.jp/dp/B0G6WYC2RZ" target="_blank" rel="noopener">Buy on Amazon</a>
          </article>

          <!-- BOOK 4 -->
          <article class="card">
            <img class="cover" src="/images/books/war-on-soils.jpg" alt="War on Soils cover" />
            <h3 style="margin:14px 0 6px;">War on Soils</h3>
            <p class="muted" style="margin:0 0 12px; font-size:14px;">A call to heal with wisdom, science, and intention</p>
            <a class="btn" href="https://www.amazon.co.jp/dp/B0F3WC74JW" target="_blank" rel="noopener">Buy on Amazon</a>
          </article>

          <!-- BOOK 5 -->
          <article class="card">
            <img class="cover" src="/images/books/college-prep-cooking.jpg" alt="The College Prep of Cooking cover" />
            <h3 style="margin:14px 0 6px;">The College Prep of Cooking</h3>
            <p class="muted" style="margin:0 0 12px; font-size:14px;">Vegetarian recipes for life in the dorm and beyond</p>
            <a class="btn" href="https://www.amazon.co.jp/dp/B0F3PB98Z4" target="_blank" rel="noopener">Buy on Amazon</a>
          </article>

        </div>
      </section>

    <!-- NEWSLETTER -->
<section id="subscribe" style="margin-top: 64px;">
  <div class="card" style="background:var(--jade-soft); text-align:center;">
    <h2 class="section-title" style="margin-bottom:10px;">Stay Connected</h2>

    <p style="margin:0 0 18px; line-height:1.7;">
      Reflections on faith, science, joy, recipes and everyday wonder.
      New books, resources, and thoughtful living—straight to your inbox.
    </p>

    <a
      class="btn"
      href="https://embellishandnourish.substack.com
"
      target="_blank"
      rel="noopener"
    >
      Join the Newsletter
    </a>
  </div>
</section>


      <footer style="margin-top: 70px; padding-top: 18px; border-top:1px solid var(--border); color:var(--muted);">
        © 2025 Embellish & Nourish. All rights reserved.
      </footer>

    </main>
  </body>
</html>
